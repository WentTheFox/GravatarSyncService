# Copy this file to /etc/gravatar-sync/config.env (root-only, mode 600 is
# fine since it holds nothing more sensitive than an email address) and
# fill in your values. It's sourced by systemd as EnvironmentFile=, so:
# no quotes, one KEY=VALUE per line.

GRAVATAR_SYNC_EMAIL=you@example.com
GRAVATAR_SYNC_USER=yourusername

# Optional, shown here with their defaults:
#GRAVATAR_SYNC_SIZE=512
#GRAVATAR_SYNC_STATE_DIR=/var/lib/gravatar-sync
