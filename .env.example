# Copy this file to /etc/gravatar-sync/.env (root-only, mode 600 is fine
# since it holds nothing more sensitive than an email address) and fill
# in your values. It's sourced by systemd as EnvironmentFile=, so: no
# quotes, one KEY=VALUE per line.

GRAVATAR_SYNC_USER=yourusername

# Optional. If left unset, the service falls back to whatever Email
# AccountsService has on record for GRAVATAR_SYNC_USER (e.g. set via
# your desktop's System Settings -> Users), and only fails if neither
# is available.
#GRAVATAR_SYNC_EMAIL=you@example.com

# Optional, shown here with their defaults:
#GRAVATAR_SYNC_SIZE=512
#GRAVATAR_SYNC_STATE_DIR=/var/lib/gravatar-sync
