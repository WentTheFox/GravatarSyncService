[Unit]
Description=Sync local account picture from Gravatar
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/gravatar-sync/.env

[Service]
Type=oneshot
EnvironmentFile=/etc/gravatar-sync/.env
ExecStart=/usr/local/bin/gravatar-sync

# Hardening. Needs root (to write AccountsService's icon dir and call it
# over the system bus without a polkit prompt) but not much else.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/var/lib/AccountsService/icons
# Auto-creates and grants write access to /var/lib/gravatar-sync; unlike
# ReadWritePaths this doesn't require the directory to pre-exist.
StateDirectory=gravatar-sync
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
